# Env var template — copy to .env.local (web/) or .env (infra/), never commit real values.
# Each block below is filled in once its owning phase actually provisions the resource
# (see docs/planning/DEVELOPMENT_PHASES.md). Empty/placeholder until then — no invented
# resource IDs.

# --- web/ (Next.js dashboard) ---

# Phase 5 (auth-stack.ts): Cognito user pool + app client, from `cdk deploy` output
NEXT_PUBLIC_COGNITO_USER_POOL_ID=
NEXT_PUBLIC_COGNITO_CLIENT_ID=
NEXT_PUBLIC_COGNITO_REGION=

# Phase 7 (api-stack.ts): API Gateway invoke URL, from `cdk deploy` output
NEXT_PUBLIC_API_BASE_URL=

# --- infra/ (CDK app) ---

# AWS account/region the stacks deploy into (Phase 4+, first real `cdk deploy`)
CDK_DEFAULT_ACCOUNT=
CDK_DEFAULT_REGION=

# Phase 6 (checkin-workflow-stack.ts): carer/family email that receives
# distress alerts, required at deploy time
ALERT_EMAIL_ADDRESS=
